# Monitoring Stack Environment Variables
# Copy this file to .env and fill in your values

# ===================================
# Slack Integration
# ===================================

# Slack Webhook URL for Error Alerts
# Get this from: https://api.slack.com/messaging/webhooks
# Example: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=

# Slack Webhook URL for Critical Alerts (optional - can use same as above)
# If not set, critical alerts will also use SLACK_WEBHOOK_URL
SLACK_WEBHOOK_URL_CRITICAL=

# ===================================
# Alert Configuration (Optional)
# ===================================

# Minimum interval between alert notifications (in minutes)
# Default: 60
ALERT_REPEAT_INTERVAL=60

# Alert evaluation interval (in seconds)
# Default: 60
ALERT_EVALUATION_INTERVAL=60

# ===================================
# Grafana Configuration (Optional)
# ===================================

# Grafana admin password
# Default: admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Grafana server URL (for links in Slack messages)
# Default: http://localhost:3002
GF_SERVER_ROOT_URL=http://localhost:3002
